## =================================================================
## config.R.example
## Created by: Daniel Vilas
##
## Usually NOT needed: scripts/wmed_paths.R finds the folders by itself
## (the standard pCloud Drive place, ~/WMed_EwE_output for the outputs),
## and the interactive page (card 0) asks for any folder it cannot find.
##
## To set the folders by hand: copy this file to "config.local.R" in the
## repo root (or scripts/) and edit the paths. config.local.R and config.R
## are git-ignored, so your paths stay on your computer.
## Order in which the folders are looked for: config.local.R -> config.R
## -> environment variables WMED_PCLOUD_DIR / WMED_OUT_DIR -> defaults.
##
## Never put passwords or the Copernicus login here: the page asks for it
## and the copernicusmarine toolbox keeps it in your user folder.
## =================================================================

## Writable output folder: the pipeline creates every subfolder it needs
## (biomass/, fisheries/, diet/, plots/, environment/, ...) and the
## workbook ecopath_ecosim_inputs.xlsx. Any folder you can write to.
out_dir <- "/path/to/your/output/folder/"

## The shared pCloud folder "EwE Western Med 2026" (read access), or an
## unzipped input snapshot from Zenodo.
pcloud_dir <- "/path/to/your/pCloud Drive/EwE Western Med 2026/"

## Your clone of this repo (the folder that holds scripts/). Optional:
## found automatically from where the scripts are.
git_dir <- "/path/to/your/clone/WMed_EwE/"
